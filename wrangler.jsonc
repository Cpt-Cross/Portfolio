{
  "name": "portfolio",
  "compatibility_date": "2026-06-02",
  "main": "worker.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/twitch",
      "/kick",
      "/yt",
      "/youtube",
      "/vods",
      "/highlights",
      "/ig",
      "/instagram",
      "/discord",
      "/linkedin",
      "/li",
      "/behance",
      "/cv",
      "/resume"
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "CLICKS",
      "dataset": "cc_clicks"
    }
  ]
}